NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://mysolar:replace-with-local-password@localhost:5432/mysolar
# Use require with a trusted PostgreSQL TLS certificate; never disable certificate checks.
# Keep SSL options out of DATABASE_URL; DATABASE_SSL is the single TLS policy setting.
DATABASE_SSL=disable
# Generate your own value with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-at-least-64-random-characters
SESSION_ABSOLUTE_HOURS=168
SESSION_IDLE_HOURS=12
# Railway: set to 1 only when every connection goes through one trusted proxy.
TRUST_PROXY_HOPS=0
# Optional mail: configure SMTP below, or RESEND_API_KEY plus a verified MAIL_FROM.
# Resend defaults to smtp.resend.com / user resend; the existing SMTP options can override TLS/port.
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Exact trusted HTTPS image hosts, comma-separated. Empty means no external logo URL is accepted.
LOGO_ALLOWED_HOSTS=
# Exact trusted hosts for product PNG/JPEG/WebP image URLs. Empty means image-free catalogue listings.
PRODUCT_IMAGE_ALLOWED_HOSTS=
# The UI defaults to secure private links shared through WhatsApp or the owner's email app.
# Automatic email requires SMTP. Legacy manual delivery remains development-only.
INVITATION_DELIVERY=email

# Optional SIA foundation. Rules work without a provider. No endpoint is called unless a user opts in.
SIA_ENABLED=true
# disabled or json-selector-v1; the latter requires an operator-managed compatible HTTPS JSON gateway.
SIA_PROVIDER=disabled
SIA_PROVIDER_URL=
SIA_API_KEY=
SIA_MODEL=
SIA_TIMEOUT_MS=12000
SIA_REQUESTS_PER_MINUTE=8
SIA_USER_DAILY_LIMIT=30
SIA_COMPANY_DAILY_LIMIT=150

# Release programme: queued mail and account protection (set through the operator secret manager).
# Separate 32-byte AES key encoded as 64 hexadecimal characters. Keep a recoverable secret backup.
# Required for queued verification/recovery/invitation mail, MFA enrolment and private file content.
# Do not reuse SESSION_SECRET or rotate this key without migrating encrypted records.
DATA_ENCRYPTION_KEY=
# Enable these policies only after verified email delivery, owner enrolment and recovery procedures work.
AUTH_REQUIRE_VERIFIED_EMAIL=false
AUTH_REQUIRE_PRIVILEGED_MFA=false
# Optional reviewed release/monitoring configuration. No alerts are sent by default.
APP_RELEASE=
OPS_ALERTS_ENABLED=false
OPS_ALERT_RECIPIENT=
DB_WARNING_BYTES=1073741824
# Optional existing operator-managed malware-scanning gateway. Empty means uploads are blocked.
# HTTPS endpoint without credentials/query/hash; Bearer secret is supplied separately.
FILE_SCAN_URL=
FILE_SCAN_KEY=
FILE_QUOTA_BYTES=104857600
