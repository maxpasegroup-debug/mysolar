{
  "name": "my-solar",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --env-file-if-exists=.env --watch server/index.js",
    "db:migrate": "node --env-file-if-exists=.env server/db/migrate.js",
    "db:cleanup": "node --env-file-if-exists=.env server/db/cleanup.js",
    "admin:grant": "node --env-file-if-exists=.env server/admin.js grant",
    "admin:revoke": "node --env-file-if-exists=.env server/admin.js revoke"
  },
  "dependencies": {
    "argon2": "0.44.0",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "nodemailer": "10.1.1",
    "pg": "8.23.1"
  }
}
